# 复制为 deploy/.env 后填写。所有值都必须是随机生成的长串，不要用示例值。
#   IM_JWT_SECRET:          openssl rand -hex 32
#   IM_ADMIN_TOKEN:         openssl rand -hex 32
#   IM_LIVEKIT_API_SECRET:  openssl rand -hex 32
#   IM_MYSQL_ROOT_PASSWORD: openssl rand -hex 16
#   IM_APP_PASSWORD:        openssl rand -hex 16
#   IM_MINIO_ROOT_PASSWORD: openssl rand -hex 16
#
# 注意：docker compose 只会把下面这些变量传给显式引用它们的服务，
# 不会自动透传宿主机环境，所以不在这里写就等于没设置。

# 登录令牌（JWT）签名密钥 —— 泄露 = 任何人可伪造任意用户登录
IM_JWT_SECRET=

# 管理后台令牌（:10003）—— 泄露 = 可重置任意用户密码、改站点配置
IM_ADMIN_TOKEN=

# 音视频（LiveKit）—— 同时用于 gateway 签发与 SFU 校验
IM_LIVEKIT_API_KEY=
IM_LIVEKIT_API_SECRET=

# MySQL root 口令：只给 mysql 容器用（首次初始化建账号 + 健康检查），应用侧不用它
IM_MYSQL_ROOT_PASSWORD=

# 应用库账号 im 的口令：三个服务用它连库，只对 im 库有权限（拿不到 mysql.user、碰不了别的库）
IM_APP_PASSWORD=

# MinIO 凭据（对象存储：附件 + 聊天归档）
IM_MINIO_ROOT_USER=
IM_MINIO_ROOT_PASSWORD=

# OIDC 登录自动回调白名单（逗号分隔的**前缀**，注意不是通配）。
# 留空 = 只允许与本站同源的回跳：浏览器授权完落在 /oidc-done 页面，用户要手工复制令牌。
# 打开下面这行即可「授权完成后自动登录」：
#   - 桌面端：客户端起本地回环监听器（127.0.0.1 随机端口）接收令牌
#   - Android：用自定义 scheme yanshu://oidc/callback 把令牌交回 App
#   - Web：页面本身就是回调目标，无需配置（同源，令牌走 fragment，读取后立刻从地址栏抹掉）
# 这个白名单是开放重定向的唯一防线，只放行你信任的目标。
# IM_OIDC_RETURN_ALLOWLIST=http://127.0.0.1,http://localhost,yanshu:

# 多副本部署时给每个实例分配不同的雪花节点号（默认 logic=2、gateway=1）
# IM_LOGIC_NODE_ID=2
# IM_GATEWAY_NODE_ID=1
