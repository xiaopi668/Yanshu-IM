# 复制为 deploy/.env 后填写。所有值都必须是随机生成的长串，不要用示例值。
#   IM_JWT_SECRET:          openssl rand -hex 32
#   IM_ADMIN_TOKEN:         openssl rand -hex 32
#   IM_LIVEKIT_API_SECRET:  openssl rand -hex 32
#   IM_MYSQL_PASSWORD:      openssl rand -hex 16
#   IM_MINIO_ROOT_PASSWORD: openssl rand -hex 16
#
# 注意：docker compose 只会把下面这些变量传给显式引用它们的服务，
# 不会自动透传宿主机环境，所以不在这里写就等于没设置。

# 登录令牌（JWT）签名密钥 —— 泄露 = 任何人可伪造任意用户登录
IM_JWT_SECRET=

# 管理后台令牌（:10003）—— 泄露 = 可重置任意用户密码、改站点配置
IM_ADMIN_TOKEN=

# 音视频（LiveKit）—— 同时用于 gateway 签发与 SFU 校验
IM_LIVEKIT_API_KEY=
IM_LIVEKIT_API_SECRET=

# MySQL root 口令（应用与 healthcheck 共用）
IM_MYSQL_PASSWORD=

# MinIO 凭据（对象存储：附件 + 聊天归档）
IM_MINIO_ROOT_USER=
IM_MINIO_ROOT_PASSWORD=

# 多副本部署时给每个实例分配不同的雪花节点号（默认 logic=2、gateway=1）
# IM_LOGIC_NODE_ID=2
# IM_GATEWAY_NODE_ID=1
