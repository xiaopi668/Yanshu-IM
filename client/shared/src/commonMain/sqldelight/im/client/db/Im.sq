CREATE TABLE message_cache (
  server_msg_id TEXT PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  seq INTEGER NOT NULL,
  from_uid TEXT NOT NULL,
  msg_type INTEGER NOT NULL,
  text TEXT,
  attachment TEXT,
  sent_at INTEGER NOT NULL,
  client_msg_id TEXT,
  pending INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX conv_seq ON message_cache(conversation_id, seq);

CREATE TABLE conversation_cache (
  id TEXT PRIMARY KEY,
  type TEXT NOT NULL,
  title TEXT NOT NULL,
  last_seq INTEGER NOT NULL DEFAULT 0,
  read_seq INTEGER NOT NULL DEFAULT 0
);

upsertMessage:
INSERT OR REPLACE INTO message_cache
  (server_msg_id, conversation_id, seq, from_uid, msg_type, text, attachment, sent_at, client_msg_id, pending)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markConfirmed:
UPDATE message_cache SET pending = 0 WHERE client_msg_id = ?;

-- pending 语义：0 = 已被服务端确认，1 = 待确认（发送中），2 = 失败（可重发）
setPendingState:
UPDATE message_cache SET pending = ? WHERE client_msg_id = ?;

deletePending:
DELETE FROM message_cache WHERE client_msg_id = ? AND pending = 1;

-- 取「最新」N 条（DESC），调用方再翻回升序。
-- 早期写成 ASC：会话超过 50 条时，重启后只剩最旧的 50 条，新消息插在中间，历史是断的。
loadRecent:
SELECT * FROM message_cache WHERE conversation_id = ? ORDER BY seq DESC LIMIT ?;

loadAllConversations:
SELECT * FROM conversation_cache;

upsertConversation:
INSERT OR REPLACE INTO conversation_cache (id, type, title, last_seq, read_seq)
VALUES (?, ?, ?, ?, ?);

clearConversation:
DELETE FROM message_cache WHERE conversation_id = ?;

loadPending:
SELECT * FROM message_cache WHERE client_msg_id = ? AND pending = 1 LIMIT 1;

clearAllMessages:
DELETE FROM message_cache;

clearAllConversations:
DELETE FROM conversation_cache;
